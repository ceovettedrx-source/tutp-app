# Copy this file to .env for LOCAL testing only.
# For the live Cloud Run deployment, do NOT put the key in a file that gets deployed —
# pass it via `--set-env-vars` (or Secret Manager) on `gcloud run deploy` instead (see README.md).

ANTHROPIC_API_KEY=your_key_here

# Where teacher/tutor registration notices are sent (defaults to ceo.tutp@gmail.com if unset).
ADMIN_NOTIFY_EMAIL=ceo.tutp@gmail.com

# Shared secret for the Cloud Scheduler -> POST /api/cron/evening-homework-alerts
# job (same pattern as ADMIN_TOKEN). No default — the route is disabled until this is set.
CRON_TOKEN=your_random_token_here

# Razorpay — separate account/key-set for Tut-P, not the VettedRx one.
# Paid-tier registration is disabled (Free tier is unaffected) until these are set.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# HMAC secret configured on the Razorpay webhook itself (Dashboard -> Webhooks),
# used to verify POST /api/webhooks/razorpay requests actually came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Plan IDs created manually in the Razorpay Dashboard (Pro ₹500/mo, UltraPro ₹1500/mo, Max ₹2500/mo).
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxx
RAZORPAY_PLAN_ID_ULTRAPRO=plan_xxxxxxxxxxxxx
RAZORPAY_PLAN_ID_MAX=plan_xxxxxxxxxxxxx
